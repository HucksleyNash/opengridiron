APP_ENV=local
APP_SECRET=replace-with-a-long-random-value
AUTH_REQUIRED=false
PUBLIC_BASE_URL=http://localhost:8787
DATABASE_URL=sqlite:////data/football.db
DATA_DIR=/data
TIMEZONE=America/Chicago
OWNER_USERNAME=owner
# Required only for the first authenticated cloud/VPN start; existing owners are retained.
OWNER_PASSWORD=
CODEX_RUNNER_URL=http://codex-runner:8090
CODEX_RUNNER_TOKEN=replace-with-a-second-random-value
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:8787/api/v1/integrations/yahoo/callback
DRAFT_SUITE_ENABLED=true
DRAFT_YAHOO_ENABLED=true
DRAFT_FORECAST_ENABLED=true
DRAFT_SIMULATION_ENABLED=true
DRAFT_AI_EXPLANATIONS_ENABLED=true
DRAFT_NFLVERSE_RANGES_ENABLED=true
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:owner@example.com
DOMAIN=football.example.com
TLS_EMAIL=owner@example.com
VPN_BIND_ADDRESS=127.0.0.1

# Source refreshes never invoke general AI analysis automatically.
# News classification runs only when an enabled provider has an explicit "news" default.
SCHEDULER_ENABLED=true
YAHOO_REFRESH_ENABLED=true
YAHOO_REFRESH_MINUTES=60
YAHOO_REQUEST_INTERVAL_SECONDS=1
NEWS_REFRESH_MINUTES=15
NFLVERSE_REFRESH_MINUTES=60
NFLVERSE_LIVE_REFRESH_MINUTES=15
SOURCE_FAILURE_COOLDOWN_MINUTES=30
CODEX_RUN_TIMEOUT_SECONDS=270
RECOVERY_TMPFS_SIZE=2g
